# Copy to .env.local and fill in the values from
# Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Either key name works. Prefer the new publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Public site URL used in confirmation and password-reset emails.
# Must also be listed under Supabase → Authentication → URL Configuration
# (Site URL + Redirect URLs: https://YOUR-DOMAIN/auth/confirm and
# https://YOUR-DOMAIN/auth/callback). Never point this at a sandbox/internal
# host in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Integration OAuth (server-only; never use NEXT_PUBLIC_ for secrets).
# Callback: ${NEXT_PUBLIC_SITE_URL}/api/integrations/callback/{provider-id}
# Production requires a canonical HTTPS NEXT_PUBLIC_SITE_URL.
# Generate 32 random bytes using a secure secret manager; 64 hex characters.
# Changing this key invalidates stored tokens: reconnect or use a reviewed rotation.
NEXUS_INTEGRATION_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Phase 2 registry only — no data adapters.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
# Stripe transport is installed but NOT activated. No environment variable enables checkout.
# Future server composition must explicitly pass secrets into StripePaymentAdapter.
# Do not use NEXT_PUBLIC_ for payment or AI secrets.
