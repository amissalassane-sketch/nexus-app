# Copy to .env.local and fill in the values from
# Supabase → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Either key name works. Prefer the new publishable key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Public site URL used in confirmation and password-reset emails.
# Must also be listed under Supabase → Authentication → URL Configuration
# (Site URL + Redirect URLs: https://YOUR-DOMAIN/auth/callback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
